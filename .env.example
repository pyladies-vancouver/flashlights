# PyLadies Vancouver's production instance. Copy to .env on the host, or set
# each variable on the platform. The core's environment reference lists
# every variable: https://docs.flashlights.app/0.1.0/developer/environment/
#
# The boot fails at once, naming every missing variable, when one of the
# required ones is unset.

# Required
SECRET_KEY=                       # python -c "import secrets; print(secrets.token_urlsafe(50))"
FERNET_KEY=                       # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_ALLOWED_HOSTS=vancouver.flashlights.app
DATABASE_URL=                     # from the platform's Postgres add-on
REDIS_URL=                        # from the platform's Redis add-on (or CELERY_BROKER_URL)
EMAIL_URL=                        # smtp://user:password@smtp.mailgun.org:587/?tls=true
DJANGO_DEFAULT_FROM_EMAIL=PyLadies Vancouver <noreply@mail.flashlights.app>
USE_OBJECT_STORAGE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=              # https://<account>.r2.cloudflarestorage.com, say

# Identity (the same values as presets/vancouver/env, plus the images the
# app ships, served by the instance itself; the favicon is not set, so the
# core draws one from the title and the colour)
SITE_TITLE=PyLadies Vancouver
SITE_SHORT_NAME=PyLadies Vancouver
SITE_DESCRIPTION=Free monthly Python meetups in Vancouver: talk nights, code jams and workshops. Newcomers welcome.
BRAND_PRESET=raspberry
SITE_LOGO=https://vancouver.flashlights.app/static/flashlights_vancouver/logo.png
SITE_OG_IMAGE=https://vancouver.flashlights.app/static/flashlights_vancouver/share.png
# DOCS_URL stays unset until the handbook has a Flashlights page that links to
# the core docs at the pinned version; until then the help links follow the image.
# DOCS_URL=https://vancouver.pyladies.com/handbook/flashlights/

# Switches
SPONSORSHIP_ENABLED=false
VOLUNTEERING_ENABLED=true
STATS_PUBLIC=true

# The app
EXTRA_APPS=flashlights_vancouver
